            }
          },
          "400": {
            "description": "Bad request"
          },
          "429": {
            "description": "Rate limit exceeded"
          }
        },
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "description": "Domain to query",
            "schema": {
              "type": "string",
              "example": "example.com"
            }
          }
        ]
      }
    },
